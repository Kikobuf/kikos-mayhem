<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kiko's Mayhem - SCP: Secret Laboratory LabAPI plugin.

    Build needs the game's own DLLs (they can't be redistributed).
    The easiest way: run scripts\install-server.ps1 (or .sh) once. It copies them into the repo's
    references\ folder (git-ignored), which this project and your editor pick up automatically.
    It also looks in the usual server install folders by itself (C:\SCPSL-Server, the Steam library, ~/scpsl).
    Or point SL_REFERENCES at the dedicated server's Managed folder, e.g.
      Windows: set SL_REFERENCES=C:\SCPSL Server\SCPSL_Data\Managed
      Linux:   export SL_REFERENCES=$HOME/scpsl/SCPSL_Data/Managed
    or pass -p:SL_REFERENCES=... to dotnet build.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>KikosMayhem</AssemblyName>
    <RootNamespace>KikosMayhem</RootNamespace>
    <Version>1.4.1</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <NoWarn>$(NoWarn);CS0618;CS8632</NoWarn>
    <_RepoRefs>$(MSBuildThisFileDirectory)../../references</_RepoRefs>
    <_SteamServer>$(MSBuildProgramFiles32)\Steam\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</_SteamServer>
    <SL_REFERENCES Condition="'$(SL_REFERENCES)' == '' and Exists('$(_RepoRefs)/Assembly-CSharp.dll')">$(_RepoRefs)</SL_REFERENCES>
    <SL_REFERENCES Condition="'$(SL_REFERENCES)' == '' and Exists('C:\SCPSL-Server\SCPSL_Data\Managed\Assembly-CSharp.dll')">C:\SCPSL-Server\SCPSL_Data\Managed</SL_REFERENCES>
    <SL_REFERENCES Condition="'$(SL_REFERENCES)' == '' and Exists('$(_SteamServer)\Assembly-CSharp.dll')">$(_SteamServer)</SL_REFERENCES>
    <SL_REFERENCES Condition="'$(SL_REFERENCES)' == '' and Exists('$(HOME)/scpsl/SCPSL_Data/Managed/Assembly-CSharp.dll')">$(HOME)/scpsl/SCPSL_Data/Managed</SL_REFERENCES>
    <SL_REFERENCES Condition="'$(SL_REFERENCES)' == ''">$(_RepoRefs)</SL_REFERENCES>
  </PropertyGroup>

  <!-- One clear message instead of thousands of "type not found" errors when the game DLLs are missing. -->
  <Target Name="CheckGameDlls" BeforeTargets="ResolveAssemblyReferences;CoreCompile" Condition="!Exists('$(SL_REFERENCES)/Assembly-CSharp.dll')">
    <Error Text="SCP:SL game DLLs not found (looked in '$(SL_REFERENCES)'). Run scripts\install-server.ps1 once (it copies them into the repo's references folder), or build with -p:SL_REFERENCES=&quot;&lt;server&gt;\SCPSL_Data\Managed&quot;." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(SL_REFERENCES)/Assembly-CSharp.dll" Private="false" Publicize="true" />
    <Reference Include="Assembly-CSharp-firstpass" HintPath="$(SL_REFERENCES)/Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="LabApi" HintPath="$(SL_REFERENCES)/LabApi.dll" Private="false" />
    <Reference Include="CommandSystem.Core" HintPath="$(SL_REFERENCES)/CommandSystem.Core.dll" Private="false" />
    <Reference Include="Mirror" HintPath="$(SL_REFERENCES)/Mirror.dll" Private="false" />
    <Reference Include="NorthwoodLib" HintPath="$(SL_REFERENCES)/NorthwoodLib.dll" Private="false" />
    <Reference Include="Pooling" HintPath="$(SL_REFERENCES)/Pooling.dll" Private="false" />
    <Reference Include="YamlDotNet" HintPath="$(SL_REFERENCES)/YamlDotNet.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(SL_REFERENCES)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(SL_REFERENCES)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(SL_REFERENCES)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="Unity.Mathematics" HintPath="$(SL_REFERENCES)/Unity.Mathematics.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Audio\*.wav" LogicalName="KikosMayhem.Audio.%(Filename).wav" />
  </ItemGroup>
</Project>
